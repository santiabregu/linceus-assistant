@startuml Diagrama de Despliegue
!pragma layout smetana
skinparam defaultFontSize 13
skinparam shadowing false
skinparam nodeStyle rectangle

title Deployment Diagram - Linceus Assistant

' ─── Cliente ─────────────────────────────────────────────────────────────────
node "User Machine" as client <<device>> {
  node "Web Browser" as browser <<execution environment>> {
    artifact "Chatbot Widget\n(HTML / JS)" as chatwidget
    artifact "Admin SPA\n(HTML / JS)" as adminspa
  }
}

' ─── Servidor de producción ──────────────────────────────────────────────────
node "DigitalOcean Droplet\n(Ubuntu 24.04 LTS)" as droplet <<execution environment>> {

  node "Nginx Container\n(port 80)" as nginx_container <<Docker container>> {
    artifact "Nginx" as nginx_art
    artifact "Static Frontend" as frontend_art
  }

  node "Rasa Container\n(port 5005)" as rasa_container <<Docker container>> <<custom image>> {
    artifact "Rasa Core 3.6.21" as rasa_art
    artifact "spaCy +\nes_core_news_md" as spacy_art
    artifact "NLU Model\n(.tar.gz)" as nlu_model
    artifact "Dialog Policies" as policies
  }

  node "Action Server Container\n(port 5055)" as action_container <<Docker container>> {
    artifact "Rasa SDK" as sdk_art
    artifact "Action Modules" as action_modules
    artifact "RAG Retriever" as rag_art
  }

  node "Admin Container\n(port 5050)" as admin_container <<Docker container>> {
    artifact "Flask Admin API" as admin_art
    artifact "Sevius / us.es\nScrapers" as scrapers_art
  }
}

' ─── Servicios externos ──────────────────────────────────────────────────────
cloud "Supabase (Cloud)" as supabase <<external service>> {
  node "PostgreSQL 15\n(port 6543)" as pg <<database server>> {
    database "Relational\nschema" as db_rel
    database "pgvector\nschema" as db_vec
  }
}

cloud "Google Cloud" as gcloud <<external service>> {
  node "Gemini API" as gemini <<API service>> {
    artifact "Gemma-3-27b-it" as gemini_llm
    artifact "text-embedding-004" as gemini_emb
  }
}

' ─── Pipeline CI/CD ──────────────────────────────────────────────────────────
cloud "GitHub" as github <<external service>> {
  node "GitHub Actions" as gha <<CI/CD>> {
    artifact "deploy.yml" as deploy_wf
  }
}

' ─── Comunicaciones runtime ──────────────────────────────────────────────────
browser --> nginx_container : <<HTTPS>>
nginx_container --> rasa_container : <<HTTP>>\n/webhooks/rest
nginx_container --> admin_container : <<HTTP>>\n/api/admin
rasa_container --> action_container : <<HTTP>>
action_container --> supabase : <<TCP/TLS>>
action_container --> gcloud : <<HTTPS>>
admin_container --> supabase : <<TCP/TLS>>
admin_container --> gcloud : <<HTTPS>>

' ─── Pipeline de despliegue ──────────────────────────────────────────────────
gha ..> droplet : <<deploy>>\nSSH

@enduml
