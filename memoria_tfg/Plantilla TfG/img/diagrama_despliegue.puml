@startuml diagrama_despliegue
!pragma layout smetana
skinparam defaultFontSize 13
skinparam shadowing false
skinparam nodeStyle rectangle

title Diagrama de despliegue - Linceus Assistant

' ─── Cliente ─────────────────────────────────────────────────────────────────
node "Equipo del usuario" as client <<dispositivo>> {
  node "Navegador web" as browser <<entorno de ejecución>> {
    artifact "Widget de chat\n(HTML / JS)" as chatwidget
    artifact "SPA de administración\n(HTML / JS)" as adminspa
  }
}

' ─── Servidor de producción ──────────────────────────────────────────────────
node "Droplet DigitalOcean\n(Ubuntu 24.04 LTS)" as droplet <<entorno de ejecución>> {

  node "Contenedor Nginx\n(puerto 80)" as nginx_container <<contenedor Docker>> {
    artifact "Nginx" as nginx_art
    artifact "Frontend estático" as frontend_art
  }

  node "Contenedor Rasa\n(puerto 5005)" as rasa_container <<contenedor Docker>> <<imagen propia>> {
    artifact "Rasa Core 3.6.21" as rasa_art
    artifact "spaCy +\nes_core_news_md" as spacy_art
    artifact "Modelo NLU\n(.tar.gz)" as nlu_model
    artifact "Políticas de diálogo" as policies
  }

  node "Contenedor Action Server\n(puerto 5055)" as action_container <<contenedor Docker>> {
    artifact "Rasa SDK" as sdk_art
    artifact "Módulos de acciones" as action_modules
    artifact "Recuperador RAG" as rag_art
  }

  node "Contenedor de administración\n(puerto 5050)" as admin_container <<contenedor Docker>> {
    artifact "API Flask de administración" as admin_art
    artifact "Scrapers Sevius / us.es" as scrapers_art
  }
}

' ─── Servicios externos ──────────────────────────────────────────────────────
cloud "Supabase (Cloud)" as supabase <<servicio externo>> {
  node "PostgreSQL 15\n(puerto 6543)" as pg <<servidor BD>> {
    database "Esquema\nrelacional" as db_rel
    database "Esquema\npgvector" as db_vec
  }
}

cloud "Google Cloud" as gcloud <<servicio externo>> {
  node "API Gemini" as gemini <<servicio API>> {
    artifact "Gemma-3-27b-it" as gemini_llm
    artifact "gemini-embedding-001" as gemini_emb
  }
}

' ─── Pipeline CI/CD ──────────────────────────────────────────────────────────
cloud "GitHub" as github <<servicio externo>> {
  node "GitHub Actions" as gha <<CI/CD>> {
    artifact "deploy.yml" as deploy_wf
  }
}

' ─── Comunicaciones runtime ──────────────────────────────────────────────────
browser --> nginx_container : <<HTTPS>>
nginx_container --> rasa_container : <<HTTP>>\n/webhooks/rest
nginx_container --> admin_container : <<HTTP>>\n/api/admin
rasa_container --> action_container : <<HTTP>>
action_container --> supabase : <<TCP/TLS>>
action_container --> gcloud : <<HTTPS>>
admin_container --> supabase : <<TCP/TLS>>
admin_container --> gcloud : <<HTTPS>>

' ─── Pipeline de despliegue ──────────────────────────────────────────────────
gha ..> droplet : <<despliegue>>\nSSH

@enduml
