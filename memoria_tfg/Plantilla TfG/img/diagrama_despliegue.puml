@startuml Diagrama de Despliegue
!pragma layout smetana
skinparam defaultFontSize 13
skinparam shadowing false
skinparam nodeStyle rectangle

title Deployment Diagram - Linceus Assistant

node "User Machine" as client <<device>> {
  node "Web Browser" as browser <<execution environment>> {
    artifact "Chatbot Widget" as chatwidget
  }
}

node "Local Server (Docker)" as server <<device>> {
  node "Nginx Container\n(Port 80)" as nginx_container <<Docker container>> {
    artifact "Nginx Web Server" as nginx_art
    artifact "Frontend (HTML/JS/CSS)" as frontend_art
  }

  node "Rasa Container\n(Port 5005)" as rasa_container <<Docker container>> {
    artifact "Rasa Core" as rasa_art
    artifact "NLU Model" as nlu_model
    artifact "Dialog Policies" as policies
  }

  node "Action Server Container\n(Port 5055)" as action_container <<Docker container>> {
    artifact "Rasa SDK Server" as sdk_art
    artifact "Action Modules" as action_modules
  }
}

cloud "Supabase (Cloud)" as supabase <<external service>> {
  node "PostgreSQL\n(Port 6543)" as pg <<database server>> {
    database "Academic\nDatabase" as db
  }
}

cloud "Google Cloud" as gcloud <<external service>> {
  node "Gemini API" as gemini <<API service>> {
    artifact "Gemini LLM\nModel" as gemini_model
  }
}

' Communications
browser -down-> nginx_container : "HTTP (Port 80)"
nginx_container -down-> rasa_container : "HTTP REST\n/webhooks/rest/webhook"
rasa_container -down-> action_container : "HTTP\n(Port 5055)"
action_container -right-> supabase : "PostgreSQL\n(Port 6543,\nconnection pooler)"
action_container -right-> gcloud : "HTTPS\n(REST API)"


@enduml
