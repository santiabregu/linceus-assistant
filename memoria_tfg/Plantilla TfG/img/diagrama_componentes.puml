@startuml diagrama_componentes
!pragma layout smetana
skinparam componentStyle uml2
skinparam defaultFontSize 13
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype ortho

' Estilo para componentes desactivados (referencia, no operativos)
skinparam component<<inactivo>> {
  BorderStyle dashed
  BorderColor #888888
  FontColor #666666
  BackgroundColor #F5F5F5
}

title Diagrama de componentes - Linceus Assistant

' ─── Capa de presentación ────────────────────────────────────────────────────
package "Capa de presentación" {
  [Widget de chat] as widget
  [SPA de administración] as adminui
}

' ─── Capa NLU / diálogo ──────────────────────────────────────────────────────
package "Capa conversacional (Rasa)" {
  [Pipeline NLU] as nlu
  [Gestor de diálogo] as dialog

  nlu -[hidden]right- dialog
}

' ─── Capa de lógica de negocio ───────────────────────────────────────────────
package "Capa de lógica de negocio (Action Server)" {
  [Despachador de acciones] as actions

  package "Módulos de dominio" as modules {
    [Asignaturas] as mod_asig
    [Horarios] as mod_hor
    [Profesorado] as mod_prof
    [Contexto] as mod_ctx
    [Fallback] as mod_fb
    [Multi-intento] <<inactivo>> as mod_multi
  }

  [Utilidades compartidas] as shared
  [Text-to-SQL] as t2sql

  actions ..> modules : <<delega>>
  modules ..> shared : <<usa>>
  modules ..> t2sql : <<usa>>
}

' ─── Capa de IA ──────────────────────────────────────────────────────────────
package "Capa de IA" {
  [Recuperador de embeddings] as retriever
  [Generador LLM] as llm
}

' ─── Capa de datos ───────────────────────────────────────────────────────────
package "Capa de datos" {
  [Cliente BD relacional] as dbclient
  [Cliente BD vectorial\n(pgvector)] as vecclient
}

' ─── Capa de administración ──────────────────────────────────────────────────
package "Capa de administración (Flask)" {
  [API REST de administración] as adminapi

  package "Módulos de administración" as adminmod {
    [CRUD de catálogo] as adm_crud
    [Scraper Sevius] as adm_sevius
    [Scraper us.es] as adm_uses
    [Parser de horarios PDF] as adm_horarios
    [Vectorizador RAG] as adm_vec
  }

  adminapi ..> adminmod : <<delega>>
}

' ─── Interfaces / relaciones entre capas ─────────────────────────────────────
widget ..> nlu : <<HTTP>>
adminui ..> adminapi : <<HTTP>>

nlu ..> dialog : intents
dialog ..> actions : <<HTTP>>

actions ..> dbclient
retriever ..> vecclient
modules ..> retriever : <<usa>>
modules ..> llm : <<usa>>

adm_vec ..> vecclient
adm_crud ..> dbclient
adm_sevius ..> adm_crud
adm_uses ..> adm_crud
adm_horarios ..> dbclient

@enduml
