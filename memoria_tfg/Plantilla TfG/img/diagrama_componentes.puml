@startuml Diagrama de Componentes
!pragma layout smetana
skinparam componentStyle uml2
skinparam defaultFontSize 13
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype ortho

title Component Diagram - Linceus Assistant

' ─── Capa de presentación ────────────────────────────────────────────────────
package "Presentation Layer" {
  [Chatbot Widget] as widget
  [Admin SPA] as adminui
}

' ─── Capa NLU / diálogo ──────────────────────────────────────────────────────
package "Conversational Layer (Rasa)" {
  [NLU Pipeline] as nlu
  [Dialog Manager] as dialog

  nlu -[hidden]right- dialog
}

' ─── Capa de lógica de negocio ───────────────────────────────────────────────
package "Business Logic Layer (Action Server)" {
  [Action Dispatcher] as actions

  package "Domain Modules" as modules {
    [Subjects] as mod_asig
    [Schedules] as mod_hor
    [Professors] as mod_prof
    [Context] as mod_ctx
    [Fallback] as mod_fb
    [Multi-Intent] as mod_multi
  }

  [Shared Helpers] as shared
  [Text-to-SQL] as t2sql

  actions ..> modules : <<delegates>>
  modules ..> shared : <<uses>>
  modules ..> t2sql : <<uses>>
}

' ─── Capa de IA ──────────────────────────────────────────────────────────────
package "AI Layer" {
  [Embedding Retriever] as retriever
  [LLM Renderer] as llm
}

' ─── Capa de datos ───────────────────────────────────────────────────────────
package "Data Layer" {
  [Relational DB Client] as dbclient
  [Vector DB Client\n(pgvector)] as vecclient
}

' ─── Capa de administración ──────────────────────────────────────────────────
package "Admin Layer (Flask)" {
  [Admin REST API] as adminapi

  package "Admin Modules" as adminmod {
    [Catalog CRUD] as adm_crud
    [Sevius Scraper] as adm_sevius
    [us.es Scraper] as adm_uses
    [PDF Horarios Parser] as adm_horarios
    [RAG Vectorizer] as adm_vec
  }

  adminapi ..> adminmod : <<delegates>>
}

' ─── Interfaces / relaciones entre capas ─────────────────────────────────────
widget ..> nlu : <<HTTP>>
adminui ..> adminapi : <<HTTP>>

nlu ..> dialog : intents
dialog ..> actions : <<HTTP>>

actions ..> dbclient
retriever ..> vecclient
modules ..> retriever : <<uses>>
modules ..> llm : <<uses>>

adm_vec ..> vecclient
adm_crud ..> dbclient
adm_sevius ..> adm_crud
adm_uses ..> adm_crud
adm_horarios ..> dbclient

@enduml
